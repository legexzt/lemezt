<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_scrim">

    <FrameLayout
        android:id="@+id/scrimDismissArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bottom Sheet Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomSheetCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="@color/lemezt_card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Drag indicator -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_bottom_sheet"
                android:backgroundTint="@color/lemezt_border" />

            <!-- Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_lemezt_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/app_name"
                        android:textColor="@color/lemezt_text_primary"
                        android:textSize="20sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close" />
            </RelativeLayout>

            <!-- Loading View -->
            <LinearLayout
                android:id="@+id/loadingContainer"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminateTint="@color/lemezt_secondary" />

                <TextView
                    android:id="@+id/tvLoadingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/fetching_video_info"
                    android:textColor="@color/lemezt_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Video Info & Options Container -->
            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Video Card Preview -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/lemezt_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/ivThumbnail"
                            android:layout_width="110dp"
                            android:layout_height="72dp"
                            android:background="@color/lemezt_dark_bg"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvVideoTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="2"
                                android:textColor="@color/lemezt_text_primary"
                                android:textSize="14sp"
                                tools:text="Michael Jackson - Billie Jean (Official Video)" />

                            <TextView
                                android:id="@+id/tvChannelAndDuration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/lemezt_text_secondary"
                                android:textSize="12sp"
                                tools:text="Michael Jackson • 4:55" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Quality Selection Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/choose_format"
                    android:textColor="@color/lemezt_text_primary"
                    android:textSize="14sp" />

                <!-- Quality Chip Group (Video) -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFormats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip1080p"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="1080p MP4"
                        android:textColor="@color/lemezt_text_primary"
                        app:chipBackgroundColor="@color/lemezt_chip_bg"
                        app:chipIcon="@drawable/ic_video" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip720p"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="720p MP4"
                        android:textColor="@color/lemezt_text_primary"
                        app:chipBackgroundColor="@color/lemezt_chip_bg"
                        app:chipIcon="@drawable/ic_video" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip480p"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="480p MP4"
                        android:textColor="@color/lemezt_text_primary"
                        app:chipBackgroundColor="@color/lemezt_chip_bg"
                        app:chipIcon="@drawable/ic_video" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMp3High"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MP3 (320 kbps)"
                        android:textColor="@color/lemezt_text_primary"
                        app:chipBackgroundColor="@color/lemezt_chip_bg"
                        app:chipIcon="@drawable/ic_audio" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMp3Standard"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MP3 (128 kbps)"
                        android:textColor="@color/lemezt_text_primary"
                        app:chipBackgroundColor="@color/lemezt_chip_bg"
                        app:chipIcon="@drawable/ic_audio" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Options: Captions & Thumbnail -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchCaptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/include_captions"
                        android:textColor="@color/lemezt_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/save_thumbnail"
                        android:textColor="@color/lemezt_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Progress Section (During Download) -->
                <LinearLayout
                    android:id="@+id/progressSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/downloadProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_button_gradient" />

                    <TextView
                        android:id="@+id/tvProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:text="0%"
                        android:textColor="@color/lemezt_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHideBackground"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/lemezt_surface"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/hide_in_background"
                        android:textAllCaps="false"
                        android:textColor="@color/lemezt_secondary"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_hide"
                        app:iconGravity="textStart"
                        app:iconTint="@color/lemezt_secondary"
                        app:strokeColor="@color/lemezt_border"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartDownload"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_button_gradient"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/download"
                    android:textAllCaps="false"
                    android:textColor="@color/lemezt_text_primary"
                    android:textSize="16sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconTint="@color/lemezt_text_primary" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

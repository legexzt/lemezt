<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lemeztAppBg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_hide"
                app:tint="?attr/lemeztTextPrimary" />

            <TextView
                android:id="@+id/tvBatchHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-black"
                android:text="Batch Review"
                android:textColor="?attr/lemeztTextPrimary"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTotalCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_floating_pill"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="0 Items"
            android:textColor="@color/lemezt_secondary"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- Bulk Format Selection Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBulkMp3"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="All as MP3 🎵"
            android:textColor="@color/lemezt_secondary"
            android:textSize="12sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/lemezt_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBulkMp4"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="All as MP4 🎬"
            android:textColor="@color/lemezt_primary"
            android:textSize="12sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/lemezt_primary" />
    </LinearLayout>

    <!-- Scrollable Item List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBatchItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Action Button: Start Batch Download -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartBatchDownload"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_gradient"
        android:fontFamily="sans-serif-black"
        android:text="🚀 Start Batch Download"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:backgroundTint="@null"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF" />

</LinearLayout>
